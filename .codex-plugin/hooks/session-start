#!/usr/bin/env bash
# basemind SessionStart hook.
#   1. Availability probe: run `basemind status` through the launcher, which also
#      caches a version-matched binary so the first MCP tool call isn't a cold install.
#   2. Context-economy nudge: always inject the operating discipline so the agent
#      defaults to basemind over grep/read and stays token-frugal.
#   3. Status-line nudge: Claude Code plugins cannot set the main status line, so
#      if the user hasn't wired it yet, append a hint about /bm-statusline.
#
# Output goes to stdout as the hook's JSON result; diagnostics would go to stderr.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

WORKSPACE="${CLAUDE_PROJECT_DIR:-$PWD}"

# The host's event (it carries the session id the agent hooks name the session by). Not read from a
# terminal, where nothing would ever arrive.
STDIN_JSON=""
if [ ! -t 0 ]; then
  STDIN_JSON="$(cat 2>/dev/null || true)"
fi

# Run "$@" for at most $1 seconds. Uses `timeout` where installed; macOS has none by default, so a
# watchdog stops the command there. The command runs in a process group of its own and the watchdog
# signals that group: a helper it left holding stdout goes too, while the daemon its CLI may have
# started, in a session of its own, is outside the group and keeps running. Standard input is passed
# through.
run_bounded() (
  secs="$1"
  shift
  if command -v timeout >/dev/null 2>&1; then
    exec timeout "$secs" "$@"
  fi
  # Job control gives a background job its own process group. The shell's job reports would go to
  # its stderr, so that is discarded and the command gets the caller's stderr from fd 3.
  exec 3>&2 2>/dev/null
  set -m
  "$@" <&0 2>&3 3>&- &
  pid=$!
  (
    nap=""
    trap '[ -z "$nap" ] || kill "$nap"; exit 0' TERM
    sleep "$secs" &
    nap=$!
    wait "$nap" || exit 0
    kill -TERM -- "-$pid"
  ) >/dev/null 3>&- &
  watchdog=$!
  wait "$pid"
  rc=$?
  kill "$watchdog"
  wait "$watchdog"
  exit "$rc"
)


# 1. PROBE before advertising. A hook that tells the agent to prefer tools that are not there is
#    worse than no hook at all: the agent burns calls hunting for them, then falls back to grep and
#    reports basemind as broken. Ask the CLI, through the same launcher the MCP server uses, for
#    this workspace's index status. That works on a default install (no HTTP front-end needed), and
#    the first run also warms the version-matched binary cache. Bounded with or without a `timeout`
#    binary and fail-open: a failure only changes the context line, never the exit status.
#    BASEMIND_HOOK_STATUS_TIMEOUT (whole seconds) overrides the bound.
STATUS_TIMEOUT="${BASEMIND_HOOK_STATUS_TIMEOUT:-20}"
case "${STATUS_TIMEOUT}" in
'' | *[!0-9]*) STATUS_TIMEOUT=20 ;;
esac
STATUS_RC=0
STATUS_JSON="$(run_bounded "${STATUS_TIMEOUT}" "${PLUGIN_ROOT}/scripts/mcp-launch.sh" status --root "${WORKSPACE}" --json </dev/null 2>/dev/null)" || STATUS_RC=$?

FILE_COUNT=""
SCHEMA_VER=""
if [ "${STATUS_RC}" -eq 0 ] && [ -n "${STATUS_JSON}" ] && command -v jq >/dev/null 2>&1; then
  FILE_COUNT="$(printf '%s' "${STATUS_JSON}" | jq -r '.file_count | numbers' 2>/dev/null || true)"
  SCHEMA_VER="$(printf '%s' "${STATUS_JSON}" | jq -r '.schema_version | numbers' 2>/dev/null || true)"
fi

# The always-loaded MCP tools this plugin's server advertises: the verb tools. Every definition
# carries `_meta["anthropic/alwaysLoad"]`, so a host that defers MCP tools still loads these at
# session start and no tool search is needed. The three agent tools of a `comms` build are deferred
# and named separately below. Claude Code namespaces plugin MCP tools as
# mcp__plugin_<plugin>_<server>__<tool>.
TOOL_PREFIX="mcp__plugin_basemind_basemind__"
TOOL_NAMES="code_outline code_symbols code_read code_grep code_search code_refs find_files docs_search git_log git_blame git_diff memory_save memory_search index_status index_rescan"
TOOL_LIST=""
for t in ${TOOL_NAMES}; do
  TOOL_LIST="${TOOL_LIST:+${TOOL_LIST}, }${t}"
done

FALLBACK="Use ordinary file and git tools for now; run /bm-doctor to diagnose."
CALL_TOOLS=" Its tools are always loaded, so call them directly with no tool search: ${TOOL_LIST}."
if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${CURSOR_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  CALL_TOOLS="${CALL_TOOLS} Claude Code registers each one as ${TOOL_PREFIX}<tool>."
fi

# 124 is `timeout`'s code; 143 is the TERM the watchdog sends where `timeout` is missing.
if [ "${STATUS_RC}" -eq 124 ] || [ "${STATUS_RC}" -eq 143 ]; then
  STATUS_LINE="basemind status timed out after ${STATUS_TIMEOUT}s (the first run may still be installing the binary), so basemind is unverified. ${FALLBACK}"
elif [ "${STATUS_RC}" -ne 0 ] || [ -z "${STATUS_JSON}" ]; then
  STATUS_LINE="basemind is unavailable: the launcher could not run \`basemind status\` (exit ${STATUS_RC}; binary missing or not installable). ${FALLBACK}"
elif ! command -v jq >/dev/null 2>&1; then
  STATUS_LINE="basemind runs but jq is not installed, so the index could not be read. ${FALLBACK}"
elif [ -z "${FILE_COUNT}" ]; then
  STATUS_LINE="basemind returned an unreadable status (no file_count). ${FALLBACK}"
elif [ "${FILE_COUNT}" -eq 0 ]; then
  STATUS_LINE="basemind index is empty for ${WORKSPACE}: run /bm-scan (basemind scan) before relying on its tools. Use ordinary file and git tools until then."
else
  STATUS_LINE="basemind verified: ${FILE_COUNT} files indexed (schema ${SCHEMA_VER:-unknown}).${CALL_TOOLS}"
fi

# The PreToolUse guard (pre-tool-guard) steers Grep and rg toward the code tools only in a session
# this probe found indexed: steering an unscanned repository's searches to code_grep earns an
# empty_index answer per call. The verdict is a per-session marker in the guard's private state
# directory: written on a verified, non-empty index, removed otherwise (a resumed or cleared
# session probes again). Best-effort; the guard stays quiet when the marker cannot be written.
private_state_dir() {
  local dir="${XDG_RUNTIME_DIR:-}"
  if [ -n "${dir}" ] && [ -d "${dir}" ] && [ ! -L "${dir}" ] && [ -O "${dir}" ]; then
    dir="${dir}/basemind"
  else
    dir="${TMPDIR:-/tmp}"
    dir="${dir%/}/basemind-$(id -u)"
  fi
  mkdir -m 700 "${dir}" 2>/dev/null || true
  [ -d "${dir}" ] && [ ! -L "${dir}" ] && [ -O "${dir}" ] || return 1
  case "$(ls -ld "${dir}" 2>/dev/null)" in
  drwx------*) printf '%s' "${dir}" ;;
  *) return 1 ;;
  esac
}
record_index_verdict() {
  local session state_dir marker_dir marker
  command -v jq >/dev/null 2>&1 || return 0
  session="$(printf '%s' "${STDIN_JSON}" | jq -r '.session_id // empty' 2>/dev/null || true)"
  [ -n "${session}" ] || return 0
  session="$(printf '%s' "${session}" | tr -c 'A-Za-z0-9._-' '_')"
  state_dir="$(private_state_dir)" || return 0
  marker_dir="${state_dir}/indexed"
  mkdir -m 700 "${marker_dir}" 2>/dev/null || true
  [ -d "${marker_dir}" ] && [ ! -L "${marker_dir}" ] || return 0
  marker="${marker_dir}/${session}"
  if [ "$1" = yes ]; then
    : >"${marker}" 2>/dev/null || true
  else
    rm -f "${marker}" 2>/dev/null || true
  fi
}
case "${STATUS_LINE}" in
"basemind verified: "*) record_index_verdict yes ;;
*) record_index_verdict no ;;
esac

ROUTING="Use basemind before shell rg, grep, find and git, and before reading whole files. What a file contains: code_outline {\"path\":\"src/store.rs\"}, then code_read {\"path\":\"src/store.rs\",\"symbol\":\"open\"} for the one body you need. Where a name is defined: code_symbols {\"name\":\"open_store\"}. What calls, implements or imports it: code_refs {\"name\":\"open_store\"}. A string or comment in indexed code: code_grep {\"pattern\":\"cache_root(\"} (literal text; add \"regex\":true for a regex). Code by what it does: code_search {\"query\":\"retry a failed upload\"}. A file by name: find_files {\"query\":\"readme\"}. History: git_log {} for recent commits (add path, query, author, symbol or rev), git_blame {\"path\":\"src/store.rs\"}, git_diff {} for the working-tree status (add path, from, to). Documents, which the code tools do not cover (markdown, config, PDFs, Jupyter notebooks): docs_search {\"query\":\"how releases are versioned\"}. Notes shared across sessions: memory_save {\"key\":\"decision/x\",\"value\":\"…\"} and memory_search {\"query\":\"…\"}. Lines are 1-based, an unknown argument is rejected, and a failure is a tool result that names the fix. For exact literals or regex outside the code map, search the files directly; a semantic miss does not establish absence. Fall back to ordinary tools when basemind cannot cover the task. The index follows your edits: if a result says stale or a new file is missing, run index_rescan {\"paths\":[\"src/store.rs\"]} for the files you touched; run index_rescan {} only when index_status {} reports an empty index, degraded or rescan_needed."
CONTEXT="${STATUS_LINE} ${ROUTING}"

# 2. Append the status-line nudge only when a basemind status line isn't wired yet.
#    Detect robustly: prefer parsing the `statusLine.command` value with jq (catches
#    any script name / absolute path that references basemind), and fall back to a
#    case-insensitive grep for "basemind" near a statusLine key when jq is absent.
#    The old literal "statusline.sh" grep missed renamed scripts and matched unrelated
#    files.
SETTINGS="${HOME}/.claude/settings.json"
statusline_wired() {
  [ -f "${SETTINGS}" ] || return 1
  if command -v jq >/dev/null 2>&1; then
    jq -e '(.statusLine.command // "") | test("basemind"; "i")' \
      "${SETTINGS}" >/dev/null 2>&1
    return $?
  fi
  # No jq: best-effort. Require both a statusLine key and a basemind reference.
  grep -qi 'statusLine' "${SETTINGS}" 2>/dev/null &&
    grep -qi 'basemind' "${SETTINGS}" 2>/dev/null
}
if ! statusline_wired; then
  CONTEXT="${CONTEXT} The basemind status line is not enabled in the user's Claude Code settings; if the user asks about the status line or basemind activity, tell them they can enable a live status line (indexed files, scan age, tool calls, tokens saved) by running the /bm-statusline command once."
fi

# 3. Agent messaging is opt-in and secondary to code navigation. In a build that has it (the
#    `agent` command answers), name the deferred tools and, when the daemon already holds unread
#    messages for the actor this session's tool calls act as, say how many. That actor is the one
#    the agent-as hook names (`agent hook name`), or the principal on a host whose hook cannot
#    rewrite a call. A peek moves no read position. Best-effort and time-boxed; comms never blocks
#    or fails session startup. Requires jq to parse the inbox JSON.
AGENT_RC=0
NAME="$(printf '%s' "${STDIN_JSON}" | run_bounded 6 "${PLUGIN_ROOT}/scripts/mcp-launch.sh" agent hook name 2>/dev/null | tr -cd 'a-z0-9_-')" || AGENT_RC=$?
if [ "${AGENT_RC}" -eq 0 ]; then
  CONTEXT="${CONTEXT} Agent messaging is opt-in through the deferred tools agent_post, agent_inbox and agent_threads (find them by tool search); a subagent that wants a separate inbox passes \`as\`."
  if command -v jq >/dev/null 2>&1; then
    AS=()
    [ -n "${NAME}" ] && AS=(--as "${NAME}")
    INBOX_JSON="$(run_bounded 8 "${PLUGIN_ROOT}/scripts/mcp-launch.sh" agent inbox --peek ${AS[@]+"${AS[@]}"} --json --limit 5 --root "${WORKSPACE}" </dev/null 2>/dev/null || true)"
    MSG_COUNT="$(printf '%s' "${INBOX_JSON}" | jq -er '.messages | arrays | length' 2>/dev/null || true)"
    if [ -n "${MSG_COUNT}" ] && [ "${MSG_COUNT}" -gt 0 ]; then
      MORE="$(printf '%s' "${INBOX_JSON}" | jq -r 'if .more == true then "at least " else "" end' 2>/dev/null || true)"
      CONTEXT="${CONTEXT} You have ${MORE}${MSG_COUNT} unread agent message(s); read them with agent_inbox."
    fi
  fi
fi

# Escape for JSON embedding (single-pass parameter substitutions).
escape_for_json() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}
CTX="$(escape_for_json "${CONTEXT}")"

# Emit the field the current harness consumes. Cursor expects additional_context;
# Claude Code expects hookSpecificOutput.additionalContext; SDK-standard hosts
# (e.g. Copilot CLI) expect a top-level additionalContext.
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  printf '{\n  "additional_context": "%s"\n}\n' "${CTX}"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "${CTX}"
else
  printf '{\n  "additionalContext": "%s"\n}\n' "${CTX}"
fi

exit 0
