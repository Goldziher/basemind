{
  "name": "basemind-opencode",
  "version": "0.33.0",
  "description": "Coding agents ask a local index of your code, git history, documents and memory over MCP or the CLI, get paths and lines instead of reading files, and coordinate in shared threads.",
  "keywords": [
    "agent-context",
    "code-map",
    "mcp",
    "rag",
    "tree-sitter",
    "pi-package"
  ],
  "homepage": "https://basemind.ai",
  "bugs": {
    "url": "https://github.com/Goldziher/basemind/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Na'aman Hirschfeld",
    "email": "nhirschfeld@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Goldziher/basemind.git",
    "directory": "opencode-plugin"
  },
  "files": [
    "basemind.js",
    "binary-check.js",
    "tui.js",
    "skills/",
    "commands/",
    "README.md",
    ".pi/extensions/"
  ],
  "type": "module",
  "main": "basemind.js",
  "exports": {
    ".": "./basemind.js",
    "./tui": "./tui.js"
  },
  "dependencies": {
    "@opencode/plugin": "^2.2.5"
  },
  "engines": {
    "node": ">=22"
  },
  "pi": {
    "extensions": [
      "./.pi/extensions"
    ],
    "skills": [
      "./skills"
    ]
  },
  "packageManager": "pnpm@12.21.0"
}
