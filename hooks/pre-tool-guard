#!/usr/bin/env bash
# basemind PreToolUse guard.
#
# Fires for the codebase-search tools and for Bash (matcher "Grep|Glob|Bash" in hooks.json)
# and steers the agent toward basemind's indexed tools, which return paths + line numbers
# instead of file bodies. Every suggestion is a callable tool with its arguments: the tools are
# always loaded, so the agent can issue the call as written. For Bash it only reacts to a code search or history lookup
# (rg, grep, git log/blame/show/diff/status, find -name); every other command proceeds silently.
# Three modes via the BASEMIND_GUARD env var:
#
#   nudge    (default) — leave the permission decision to the host and attach a one-time
#                        advisory naming the basemind call that replaces it. Fires once per
#                        agent per tool kind.
#   redirect           — deny a Grep/Glob call with a reason telling the agent to use the
#                        basemind tool instead. Enforcing; no dedup. Bash stays advisory.
#   off                — no-op.
#
# Hook input fields used: tool_name, tool_input.command (Bash), tool_input.pattern, .path and
# .glob (Grep), cwd, session_id and, when the call comes from a subagent, agent_id. Without
# agent_id the marker is per session.
#
# Output is the PreToolUse JSON result on stdout; the hook never blocks startup and
# degrades to a silent no-op (exit 0 = proceed normally) when it cannot run.
set -euo pipefail

MODE="${BASEMIND_GUARD:-nudge}"
[ "${MODE}" = "off" ] && exit 0

# Need jq to read the event payload + emit well-formed JSON; degrade to no-op if absent.
command -v jq >/dev/null 2>&1 || exit 0

input="$(cat 2>/dev/null || true)"
[ -n "${input}" ] || exit 0
tool="$(printf '%s' "${input}" | jq -r '.tool_name // empty' 2>/dev/null || true)"
session="$(printf '%s' "${input}" | jq -r '.session_id // "nosession"' 2>/dev/null || echo nosession)"

agent="$(printf '%s' "${input}" | jq -r '.agent_id // "main"' 2>/dev/null || echo main)"

# Name the basemind call that replaces a Bash search or history command; empty when the
# command is something else. Only a command in leading position counts (start, or after
# ; && || or a new line, which grep treats as a line start), so `cmd | grep x` output
# filtering is not mistaken for a search.
bash_kind=""
bash_alt=""
classify_bash() {
  local cmd="$1" lead='(^|;|&&|\|\|)[[:space:]]*(sudo[[:space:]]+)?'
  if printf '%s' "${cmd}" | grep -Eq "${lead}(rg|grep|egrep|fgrep|ag|ack)([[:space:]]|\$)"; then
    bash_kind="search"
    bash_alt='basemind code_grep {"pattern":"…"} (literal text in indexed code, markdown, config and data files; add "regex":true for a regex and "path":"src/" to scope it; a file the index leaves out still needs rg), code_symbols {"name":"…"} for a definition or code_refs {"name":"…"} for usages; a question by meaning: docs_search {"query":"…"}'
  elif printf '%s' "${cmd}" | grep -Eq "${lead}git([[:space:]]+-C[[:space:]]+[^[:space:]]+)?[[:space:]]+blame([[:space:]]|\$)"; then
    bash_kind="blame"
    bash_alt='basemind git_blame {"path":"…"} (add "line" and "end_line" for a span, or "symbol" for one symbol)'
  elif printf '%s' "${cmd}" | grep -Eq "${lead}git([[:space:]]+-C[[:space:]]+[^[:space:]]+)?[[:space:]]+log([[:space:]]|\$)"; then
    bash_kind="log"
    bash_alt='basemind git_log {} (recent commits), git_log {"path":"…"} (commits touching a file), git_log {"query":"…"} (commit messages; "author" searches authors) or git_log {"path":"…","symbol":"…"} (one symbol)'
  elif printf '%s' "${cmd}" | grep -Eq "${lead}git([[:space:]]+-C[[:space:]]+[^[:space:]]+)?[[:space:]]+show([[:space:]]|\$)"; then
    bash_kind="show"
    bash_alt='basemind git_log {"rev":"…"} (one commit in full) or git_diff {"path":"…","from":"…","to":"…"} (one file between revisions)'
  # git_diff compares HEAD with the working tree, so a diff of the staged index or of two
  # arbitrary files is left alone.
  elif printf '%s' "${cmd}" | grep -Eq "${lead}git([[:space:]]+-C[[:space:]]+[^[:space:]]+)?[[:space:]]+diff([[:space:]]|\$)" &&
    ! printf '%s' "${cmd}" | grep -Eq -- '--(cached|staged|no-index)([[:space:]=]|$)'; then
    bash_kind="diff"
    bash_alt='basemind git_diff {"path":"…"} (one file against HEAD; add "from" and "to" for two revisions) or git_diff {} (the working-tree status)'
  elif printf '%s' "${cmd}" | grep -Eq "${lead}git([[:space:]]+-C[[:space:]]+[^[:space:]]+)?[[:space:]]+status([[:space:]]|\$)"; then
    bash_kind="status"
    bash_alt='basemind git_diff {} (the working-tree status; add "path" with a directory ending in / to narrow it)'
  elif printf '%s' "${cmd}" | grep -Eq "${lead}find[[:space:]].*-(i?name|i?path|i?regex)([[:space:]]|\$)"; then
    bash_kind="find"
    bash_alt='basemind find_files {"query":"…"} (fuzzy file name or path; omit "query" and pass "path" (a prefix, or a glob with *) or "language" to list)'
  fi
}

# The Grep tool's path relative to the repository root (git's top level, else cwd): a directory
# becomes a `dir/` prefix and a file its path. Empty for the root itself, a missing path or one
# outside the repository, which code_grep cannot scope to.
repo_relative() {
  local target="$1" cwd="$2" root dir base=""
  [ -n "${target}" ] || return 0
  case "${target}" in
  /*) ;;
  *) target="${cwd%/}/${target}" ;;
  esac
  root="$(git -C "${cwd}" rev-parse --show-toplevel 2>/dev/null || printf '%s' "${cwd}")"
  root="$(cd "${root}" 2>/dev/null && pwd -P)" || return 0
  if [ -d "${target}" ]; then
    dir="$(cd "${target}" && pwd -P)" || return 0
  elif [ -e "${target}" ]; then
    dir="$(cd "$(dirname "${target}")" && pwd -P)" || return 0
    base="$(basename "${target}")"
  else
    return 0
  fi
  case "${dir}/" in
  "${root}/") printf '%s' "${base}" ;;
  "${root}/"*)
    dir="${dir#"${root}"/}/"
    printf '%s' "${dir}${base}"
    ;;
  esac
}

# code_grep's `path` for a Grep call: the repo-relative path, narrowed by the Grep glob. A glob
# without a `/` matches a file name at any depth, as in the Grep tool; a negated glob or one
# given with a single file adds nothing.
grep_scope() {
  local prefix="$1" glob="$2"
  case "${glob}" in
  "" | "!"*)
    printf '%s' "${prefix}"
    return 0
    ;;
  esac
  case "${prefix}" in
  "" | */) ;;
  *)
    printf '%s' "${prefix}"
    return 0
    ;;
  esac
  case "${glob}" in
  */*) ;;
  *) glob="**/${glob}" ;;
  esac
  printf '%s' "${prefix}${glob}"
}

# Tailor the suggestion to the tool. Anything outside the matcher set just proceeds.
kind="${tool}"
case "${tool}" in
Bash)
  command_text="$(printf '%s' "${input}" | jq -r '.tool_input.command // empty' 2>/dev/null || true)"
  [ -n "${command_text}" ] || exit 0
  classify_bash "${command_text}"
  [ -n "${bash_kind}" ] || exit 0
  kind="Bash-${bash_kind}"
  alt="${bash_alt}"
  [ "${MODE}" = "redirect" ] && MODE="nudge"
  ;;
Grep)
  # The Grep tool's pattern is a regex, so the suggested call carries it verbatim with regex on,
  # scoped to the Grep call's path and glob.
  grep_call='code_grep {"pattern":"…","regex":true}'
  grep_pattern="$(printf '%s' "${input}" | jq -r '.tool_input.pattern // empty' 2>/dev/null || true)"
  grep_path="$(printf '%s' "${input}" | jq -r '.tool_input.path // empty' 2>/dev/null || true)"
  grep_glob="$(printf '%s' "${input}" | jq -r '.tool_input.glob // empty' 2>/dev/null || true)"
  grep_cwd="$(printf '%s' "${input}" | jq -r '.cwd // empty' 2>/dev/null || true)"
  [ -n "${grep_cwd}" ] || grep_cwd="$(pwd)"
  # Grep without a path searches its working directory, so scope to cwd as for an explicit ".".
  [ -n "${grep_path}" ] || grep_path="."
  grep_path="$(grep_scope "$(repo_relative "${grep_path}" "${grep_cwd}")" "${grep_glob}")"
  grep_args="$(jq -cn --arg p "${grep_pattern:-…}" --arg s "${grep_path}" \
    '{pattern:$p,regex:true} + (if $s == "" then {} else {path:$s} end)' 2>/dev/null || true)"
  if [ -n "${grep_args}" ]; then
    grep_call="code_grep ${grep_args}"
  fi
  alt="basemind ${grep_call} (indexed code, markdown, config and data files; a file the index leaves out still needs rg in Bash), code_symbols {\"name\":\"…\"} for a definition or code_refs {\"name\":\"…\"} for usages; a question by meaning: docs_search {\"query\":\"…\"}"
  ;;
Glob)
  alt='basemind find_files {"query":"…"} (fuzzy file name or path; omit "query" and pass "path" (a prefix, or a glob with *) or "language" to list)'
  ;;
*)
  exit 0
  ;;
esac

# Advice carries no permissionDecision: "allow" would skip the host's own permission prompt for the
# command, and this hook only looks at how the command starts.
emit_advice() {
  jq -cn --arg m "$1" \
    '{hookSpecificOutput:{hookEventName:"PreToolUse",additionalContext:$m}}'
}
emit_deny() {
  jq -cn --arg m "$1" \
    '{hookSpecificOutput:{hookEventName:"PreToolUse",permissionDecision:"deny",permissionDecisionReason:$m}}'
}

# The markers live in a directory only this user can write: $XDG_RUNTIME_DIR/basemind, else
# ${TMPDIR:-/tmp}/basemind-<uid>. A link, another user's directory or one open to others is not
# used, so no marker is read or written through a path another local user planted; the guard then
# stays silent.
private_state_dir() {
  local dir="${XDG_RUNTIME_DIR:-}"
  if [ -n "${dir}" ] && [ -d "${dir}" ] && [ ! -L "${dir}" ] && [ -O "${dir}" ]; then
    dir="${dir}/basemind"
  else
    dir="${TMPDIR:-/tmp}"
    dir="${dir%/}/basemind-$(id -u)"
  fi
  mkdir -m 700 "${dir}" 2>/dev/null || true
  [ -d "${dir}" ] && [ ! -L "${dir}" ] && [ -O "${dir}" ] || return 1
  case "$(ls -ld "${dir}" 2>/dev/null)" in
  drwx------*) printf '%s' "${dir}" ;;
  *) return 1 ;;
  esac
}
# Steer only where the code tools can answer: session-start leaves an `indexed/<session>` marker in
# the private state directory when its probe found this workspace indexed. Without it (an unscanned
# repository, a failed probe, an unwritable directory) every call proceeds silently.
safe_session="$(printf '%s' "${session}" | tr -c 'A-Za-z0-9._-' '_')"
[ -n "${safe_session}" ] || safe_session="nosession"
state_dir="$(private_state_dir)" || exit 0
[ -f "${state_dir}/indexed/${safe_session}" ] || exit 0

if [ "${MODE}" = "redirect" ]; then
  emit_deny "Use ${alt} instead of ${tool} for codebase navigation — it answers from the index \
(paths + line numbers, a fraction of the tokens) and is already loaded, so call it directly. Set \
BASEMIND_GUARD=nudge to make this advisory, or BASEMIND_GUARD=off to disable."
  exit 0
fi

# nudge: one advisory per agent per tool kind so it informs without nagging.
# Sanitize session_id and agent_id before building a path from it — it is untrusted input, and a
# value containing "/" or ".." would otherwise let the marker escape marker_dir.
# Collapse everything outside [A-Za-z0-9._-] to "_".
safe_agent="$(printf '%s' "${agent}" | tr -c 'A-Za-z0-9._-' '_')"
[ -n "${safe_agent}" ] || safe_agent="main"
marker_dir="${state_dir}/guard"
mkdir -m 700 "${marker_dir}" 2>/dev/null || true
marker="${marker_dir}/${safe_session}.${safe_agent}.${kind}"
if [ -e "${marker}" ]; then
  exit 0
fi
: >"${marker}" 2>/dev/null || true

emit_advice "basemind is indexed for this repo. Instead of this ${tool} call, use ${alt} — it returns \
paths + line numbers without reading file bodies, at a fraction of the tokens, and is already \
loaded, so call it directly. Proceeding with ${tool} for now. (BASEMIND_GUARD=off silences this; \
=redirect enforces it.)"
exit 0
