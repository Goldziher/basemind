#!/usr/bin/env bash
# basemind PreToolUse hook for the deferred agent tools (agent_post, agent_inbox, agent_threads).
#
# Pipes the hook event to `basemind agent hook pre-tool-use`, which names the caller's sub-identity
# (the subagent, or else the session) and, when the call carries no `as`, answers with
#   {"hookSpecificOutput":{"hookEventName":"PreToolUse","updatedInput":{...,"as":"<name>"}}}
# so two sessions or subagents in one checkout keep separate inboxes. The launcher sets
# BASEMIND_HOST exactly as it does for `serve`, so the name resolves under the same principal.
#
# Hard rule: this must NEVER block or fail the tool call. It is time-boxed and fail-open: any error
# (no binary, no daemon, unreadable event) exits 0 with no output, and the call proceeds unchanged.

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

STDIN_JSON="$(cat 2>/dev/null || true)"
[ -n "$STDIN_JSON" ] || exit 0

# macOS has no coreutils `timeout` by default; run unbounded there rather than failing every call.
if command -v timeout >/dev/null 2>&1; then
  OUT="$(printf '%s' "$STDIN_JSON" | timeout 6 "${PLUGIN_ROOT}/scripts/mcp-launch.sh" agent hook pre-tool-use 2>/dev/null)" || exit 0
else
  OUT="$(printf '%s' "$STDIN_JSON" | "${PLUGIN_ROOT}/scripts/mcp-launch.sh" agent hook pre-tool-use 2>/dev/null)" || exit 0
fi
[ -n "$OUT" ] || exit 0

printf '%s\n' "$OUT"
exit 0
