#!/usr/bin/env bash
# basemind UserPromptSubmit hook: tell the model about unread agent messages.
#
# Names this session (`basemind agent hook name`, the same name the agent-as hook gives its tool
# calls), then asks the daemon for an announcing read of that actor's inbox: front matter only,
# never a body, and it never marks anything read. A message is announced once; it stays unread
# until the agent reads it with agent_inbox. The daemon keeps the announcement mark, so this hook
# holds no state of its own.
#
# Hard rule: this must NEVER block or fail the user's turn. Every step is time-boxed and
# fail-open: any error (no daemon, no jq, no messages) exits 0 with no output.

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
LAUNCHER="${PLUGIN_ROOT}/scripts/mcp-launch.sh"

# jq is required to parse the inbox JSON; without it, stay silent.
command -v jq >/dev/null 2>&1 || exit 0

STDIN_JSON="$(cat 2>/dev/null || true)"

# macOS has no coreutils `timeout` by default; run unbounded there rather than failing every turn.
run_launcher() {
  if command -v timeout >/dev/null 2>&1; then
    timeout 6 "$LAUNCHER" "$@" 2>/dev/null
  else
    "$LAUNCHER" "$@" 2>/dev/null
  fi
}

NAME="$(printf '%s' "$STDIN_JSON" | run_launcher agent hook name | tr -cd 'a-z0-9_-')" || exit 0
[ -n "$NAME" ] || exit 0

INBOX_JSON="$(run_launcher agent inbox --announce --as "$NAME" --json --limit 10 --root "$PWD")" || exit 0
[ -n "$INBOX_JSON" ] || exit 0

LINES="$(printf '%s' "$INBOX_JSON" |
  jq -r '.messages[]? | "  - from \(.from) in \(.subject) (\(.id), \(.body_bytes // 0) bytes)"' 2>/dev/null)"
[ -n "$LINES" ] || exit 0

MORE=""
if [ "$(printf '%s' "$INBOX_JSON" | jq -r '.more // false' 2>/dev/null)" = "true" ]; then
  MORE=$'\n'"There is more unread than listed."
fi

CONTEXT="Unread basemind agent messages (announced once, not yet read):
${LINES}${MORE}
Read them with agent_inbox (bodies inline; {\"id\":\"<id>\"} reads one whole message). The agent tools are deferred: find agent_post, agent_inbox and agent_threads by tool search. Reply with agent_post if warranted."

# Escape for JSON embedding (single-pass parameter substitutions; mirrors session-start).
escape_for_json() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}
CTX="$(escape_for_json "${CONTEXT}")"

# Emit the field the current harness consumes (same tri-format branch as session-start).
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  printf '{\n  "additional_context": "%s"\n}\n' "${CTX}"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "UserPromptSubmit",\n    "additionalContext": "%s"\n  }\n}\n' "${CTX}"
else
  printf '{\n  "additionalContext": "%s"\n}\n' "${CTX}"
fi

exit 0
