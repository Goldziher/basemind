/target
/.basemind
# poly (polylint) local cache
/.polylint
*.swp

# Release build artifacts
/dist
# Binary the plugin MCP launcher (scripts/mcp-launch.sh) downloads on demand
/bin/
/pip-package/build
/pip-package/dist
/pip-package/basemind.egg-info
/pip-package-hermes/build
/pip-package-hermes/dist
/pip-package-hermes/basemind_hermes_plugin.egg-info
/npm-package/bin/*
!/npm-package/bin/basemind.js
/npm-package/node_modules
/npm-package/*.tgz
/opencode-plugin/node_modules
/opencode-plugin/*.tgz


# Python bytecode
__pycache__/
*.pyc


# Codex plugin: tracked manifests that live under otherwise-ignored paths.
# `.mcp.json` (line above) and `.agents/` (ai-rulez block) are ignored broadly,
# but these two files are hand-authored, version-controlled Codex plugin surfaces
# and MUST ship — re-include them explicitly.
!.codex-plugin/.mcp.json
!.agents/
.agents/*
!.agents/plugins/
!.agents/plugins/marketplace.json

poly.local.toml

# ai-rulez harness outputs left over from a wider `presets` set than the current one
# (config.toml now generates only "claude" + "codex", which the managed block below covers).
# Every file here carries the "AI-RULEZ :: GENERATED FILE" header — it is derived from
# .ai-rulez/, regenerable, and machine-local, so it stays out of git like the rest of the
# generated harness surface. Kept on disk because these are the live rule files for whichever
# editors a contributor happens to run.
.cline/
.clinerules/
.continue/
.cursor/
.gemini/
.junie/
.opencode/
.windsurf/
GEMINI.md
.github/copilot-instructions.md
.github/agents/
.github/commands/
.github/skills/

# Local secrets / API keys — never commit
.env
.env.*
!.env.example

# BEGIN ai-rulez (DO NOT EDIT - managed by ai-rulez)
.ai-rulez/.generated-manifest.json
.claude/agents/
.claude/plugins.json
.claude/rules/agent-comms.md
.claude/rules/agent-workflow.md
.claude/rules/atomic-commits.md
.claude/rules/basemind-usage.md
.claude/rules/branch-hygiene.md
.claude/rules/commit-messages.md
.claude/rules/communication-style.md
.claude/rules/context-preservation.md
.claude/rules/explain-reasoning.md
.claude/rules/github-workflow.md
.claude/rules/inline-documentation.md
.claude/rules/input-validation.md
.claude/rules/least-privilege.md
.claude/rules/mcp-tool-conventions.md
.claude/rules/minimal-changes.md
.claude/rules/module-size-cap.md
.claude/rules/no-ai-signatures.md
.claude/rules/output-awareness.md
.claude/rules/perf-discipline.md
.claude/rules/pipeline-standards.md
.claude/rules/read-before-write.md
.claude/rules/readme-standards.md
.claude/rules/release-versioning.md
.claude/rules/safe-git-operations.md
.claude/rules/schema-and-blob-compat.md
.claude/rules/secrets-handling.md
.claude/rules/systematic-debugging.md
.claude/rules/tdd-and-poly.md
.claude/rules/test-alongside-code.md
.claude/rules/update-docs-with-code.md
.claude/rules/verification-before-completion.md
.claude/settings.json
.claude/skills/
.codex/agents/
.codex/commands/
.codex/plugins.json
.codex/skills/
.mcp.json
AGENTS.md
CLAUDE.md
opencode.json
# END ai-rulez

.env
/node_modules/
