{
  "name": "basemind",
  "version": "0.34.0",
  "description": "Coding agents ask a local index of your code, git history, documents and memory over MCP or the CLI, get paths and lines instead of reading files, and coordinate in shared threads.",
  "contextFileName": "assets/GEMINI.md",
  "mcpServers": {
    "basemind": {
      "command": "${extensionPath}/scripts/mcp-launch.cmd",
      "args": [
        "serve"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${extensionPath}/hooks/run-hook.cmd\" pre-tool-guard",
            "async": false
          }
        ]
      },
      {
        "matcher": "mcp__.*basemind.*__agent_(post|inbox|threads)",
        "hooks": [
          {
            "type": "command",
            "command": "\"${extensionPath}/hooks/run-hook.cmd\" agent-as",
            "async": false
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${extensionPath}/hooks/run-hook.cmd\" session-start",
            "async": false
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${extensionPath}/hooks/run-hook.cmd\" inbox-notify",
            "async": false
          }
        ]
      }
    ]
  }
}
