#!/usr/bin/env bash
# basemind UserPromptSubmit hook: tell the model about unread agent messages.
#
# Names this session (`basemind agent hook name`, the same name the agent-as hook gives its tool
# calls), then asks the daemon for an announcing read of that actor's inbox: front matter only,
# never a body, and it never marks anything read. On a host whose hook cannot rewrite a tool call's
# input the binary names nothing, the tool calls act as the principal, and so does this read. A
# message is announced once; it stays unread until the agent reads it with agent_inbox. The daemon
# keeps the announcement mark, so this hook holds no state of its own.
#
# Hard rule: this must NEVER block or fail the user's turn. Every step is time-boxed and
# fail-open: any error (no daemon, no jq, no messages) exits 0 with no output.

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
LAUNCHER="${PLUGIN_ROOT}/scripts/mcp-launch.sh"

# jq is required to parse the inbox JSON; without it, stay silent.
command -v jq >/dev/null 2>&1 || exit 0

STDIN_JSON="$(cat 2>/dev/null || true)"

# Run "$@" for at most $1 seconds. Uses `timeout` where installed; macOS has none by default, so a
# watchdog stops the command there. The command runs in a process group of its own and the watchdog
# signals that group: a helper it left holding stdout goes too, while the daemon its CLI may have
# started, in a session of its own, is outside the group and keeps running. Standard input is passed
# through.
run_bounded() (
  secs="$1"
  shift
  if command -v timeout >/dev/null 2>&1; then
    exec timeout "$secs" "$@"
  fi
  # Job control gives a background job its own process group. The shell's job reports would go to
  # its stderr, so that is discarded and the command gets the caller's stderr from fd 3.
  exec 3>&2 2>/dev/null
  set -m
  "$@" <&0 2>&3 3>&- &
  pid=$!
  (
    nap=""
    trap '[ -z "$nap" ] || kill "$nap"; exit 0' TERM
    sleep "$secs" &
    nap=$!
    wait "$nap" || exit 0
    kill -TERM -- "-$pid"
  ) >/dev/null 3>&- &
  watchdog=$!
  wait "$pid"
  rc=$?
  kill "$watchdog"
  wait "$watchdog"
  exit "$rc"
)

run_launcher() {
  run_bounded 6 "$LAUNCHER" "$@" 2>/dev/null
}

# An empty name with success means the host applies no rewritten input, so the tool calls act as the
# principal and so does the read. A failure (timeout, no launcher) is not that: reading as the
# principal then would announce to an actor this session never reads as.
NAME="$(printf '%s' "$STDIN_JSON" | run_launcher agent hook name | tr -cd 'a-z0-9_-')" || exit 0
AS=()
[ -n "$NAME" ] && AS=(--as "$NAME")

INBOX_JSON="$(run_launcher agent inbox --announce ${AS[@]+"${AS[@]}"} --json --limit 10 --root "$PWD" </dev/null)" || exit 0
[ -n "$INBOX_JSON" ] || exit 0

LINES="$(printf '%s' "$INBOX_JSON" |
  jq -r '.messages[]? | "  - from \(.from) in \(.subject) (\(.id), \(.body_bytes // 0) bytes)"' 2>/dev/null)"
[ -n "$LINES" ] || exit 0

MORE=""
if [ "$(printf '%s' "$INBOX_JSON" | jq -r '.more // false' 2>/dev/null)" = "true" ]; then
  MORE=$'\n'"There is more unread than listed."
fi

CONTEXT="Unread agent messages from basemind (announced once, not yet read):
${LINES}${MORE}
Read them with agent_inbox (bodies inline; {\"id\":\"<id>\"} reads one whole message). The agent tools are deferred: find agent_post, agent_inbox and agent_threads by tool search. Reply with agent_post if warranted."

# Emit the field the current harness consumes (same tri-format branch as session-start). jq builds
# the JSON: the subjects and senders come from other agents.
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  jq -n --arg ctx "$CONTEXT" '{additional_context: $ctx}'
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  jq -n --arg ctx "$CONTEXT" '{hookSpecificOutput: {hookEventName: "UserPromptSubmit", additionalContext: $ctx}}'
else
  jq -n --arg ctx "$CONTEXT" '{additionalContext: $ctx}'
fi

exit 0
