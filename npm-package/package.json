{
  "name": "basemind",
  "version": "0.33.0",
  "description": "Coding agents ask a local index of your code, git history, documents and memory over MCP or the CLI, get paths and lines instead of reading files, and coordinate in shared threads.",
  "keywords": [
    "agent-context",
    "code-map",
    "mcp",
    "rag",
    "tree-sitter"
  ],
  "homepage": "https://basemind.ai",
  "bugs": {
    "url": "https://github.com/Goldziher/basemind/issues"
  },
  "license": "MIT",
  "author": "Na'aman Hirschfeld",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Goldziher/basemind.git"
  },
  "bin": {
    "basemind": "bin/basemind.js"
  },
  "files": [
    "index.js",
    "install.js",
    "bin/"
  ],
  "main": "index.js",
  "scripts": {
    "postinstall": "node install.js"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "tar": "^7.5.22"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.16.1"
}
